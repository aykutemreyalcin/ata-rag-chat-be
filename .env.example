POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ata_rag
POSTGRES_USER=ata
POSTGRES_PASSWORD=ata

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173

CRAWL_BASE_URL=https://akademiata.pl
# Google Apps Script JSON used by akademiata.pl tuition calculator
PRICING_API_URL=https://script.google.com/macros/s/AKfycby89Mt7UgeY6jKnq2YQNwumt_CBp46UVd1mbKvxqEkg_46vjGAeN-8lcL_OokQVFnAW/exec
PRICING_CITATION_URL=https://akademiata.pl/kalkulator-czesnego/

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CONFIDENCE_THRESHOLD=0.55

# Optional grounded generation provider. Vertex takes precedence when enabled.
VERTEX_AI_ENABLED=false
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_GEMINI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# 0 = unlimited. Use a small number for local smoke crawls.
CRAWL_MAX_PAGES=8
CRAWL_TIMEOUT_SECONDS=20
INGEST_SCHEDULER_ENABLED=false

BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
